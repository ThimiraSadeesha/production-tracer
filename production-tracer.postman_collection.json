          "name": "By shift + department",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/setup/operators/by-shift?departmentId=1&shiftId=1",
              "host": ["{{baseUrl}}"],
              "path": ["setup", "operators", "by-shift"],
              "query": [
                { "key": "departmentId", "value": "1" },
                { "key": "shiftId", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "By department",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/setup/operators/department/:departmentId", "host": ["{{baseUrl}}"], "path": ["setup", "operators", "department", ":departmentId"], "variable": [{ "key": "departmentId", "value": "1" }] }
