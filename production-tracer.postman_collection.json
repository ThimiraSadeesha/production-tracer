          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User", "value": "{{actor}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"unitCode\": \"PCS\",\n  \"unitName\": \"Pieces\",\n  \"unitSymbol\": \"pcs\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/setup/units", "host": ["{{baseUrl}}"], "path": ["setup", "units"] }
          }
        },
        {
          "name": "Update (patch)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User", "value": "{{actor}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"unitName\": \"Pieces\",\n  \"unitStatus\": \"Active\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/setup/units/:id", "host": ["{{baseUrl}}"], "path": ["setup", "units", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
