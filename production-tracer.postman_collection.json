              "path": ["setup", "shifts", "output-history"],
              "query": [
                { "key": "departmentId", "value": "-1" },
                { "key": "shiftId", "value": "-1" },
                { "key": "from", "value": "", "description": "YYYY-MM-DD" },
                { "key": "to", "value": "", "description": "YYYY-MM-DD" }
              ]
            }
          }
        },
        {
          "name": "By department",
          "request": {
            "method": "GET",
            "header": [],
