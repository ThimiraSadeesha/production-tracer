              "raw": "[\n  {\n    \"code\": \"PRC-001\",\n    \"name\": \"Offset Printing\",\n    \"status\": \"Active\",\n    \"isRequired\": 1,\n    \"departmentId\": 1,\n    \"processAttributes\": [\n      { \"attributeName\": \"Impressions\", \"isRequired\": 1 },\n      { \"attributeName\": \"Waste\", \"isRequired\": 0 }\n    ]\n  }\n]",
