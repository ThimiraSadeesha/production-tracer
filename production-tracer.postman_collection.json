            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User", "value": "{{actor}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"PRC-001\",\n  \"name\": \"Offset Printing\",\n  \"status\": \"Active\",\n  \"isRequired\": 1,\n  \"departmentId\": 1\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/setup/processes/:id", "host": ["{{baseUrl}}"], "path": ["setup", "processes", ":id"], "variable": [{ "key": "id", "value": "1" }] }
          }
        }
      ]
    },
    {
      "name": "Setup / Operators",
      "item": [
        {
          "name": "Find (filter + cursor)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/setup/operators/find?empNo=&name=&section=&status=&departmentId=-1&cursor=-1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["setup", "operators", "find"],
              "query": [
                { "key": "empNo", "value": "" },
                { "key": "name", "value": "" },
                { "key": "section", "value": "" },
                { "key": "status", "value": "" },
                { "key": "departmentId", "value": "-1", "description": "-1 = any department" },
                { "key": "cursor", "value": "-1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
