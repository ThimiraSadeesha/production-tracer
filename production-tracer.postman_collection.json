{
  "info": {
    "name": "Production Tracer API",
    "description": "Current endpoints: health, setup master-data (departments, units, processes, operators, shifts, devices) and work-orders. Base URL and actor are collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "actor", "value": "thimira" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Setup / Departments",
      "item": [
        {
          "name": "List all",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/setup/departments", "host": ["{{baseUrl}}"], "path": ["setup", "departments"] }
          }
        },
        {
          "name": "Find (filter + cursor)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/setup/departments/find?code=&name=&status=&cursor=&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["setup", "departments", "find"],
              "query": [
                { "key": "code", "value": "" },
                { "key": "name", "value": "" },
                { "key": "status", "value": "" },
                { "key": "cursor", "value": "", "description": "last id of previous page; empty/-1 for first page" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/setup/departments/:id",
              "host": ["{{baseUrl}}"],
              "path": ["setup", "departments", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User", "value": "{{actor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departmentCode\": \"DEP-001\",\n  \"departmentName\": \"Printing\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/setup/departments", "host": ["{{baseUrl}}"], "path": ["setup", "departments"] }
          }
        },
        {
          "name": "Update (patch)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User", "value": "{{actor}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departmentName\": \"Digital Printing\",\n  \"departmentStatus\": \"Active\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/setup/departments/:id",
              "host": ["{{baseUrl}}"],
              "path": ["setup", "departments", ":id"],
              "variable": [{ "key": "id", "value": "1" }]
            }
          }
        }
      ]
    },
    {
